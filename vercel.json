{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/onboarding", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/summary", "destination": "/index.html" },
    { "source": "/access", "destination": "/index.html" },
    { "source": "/payment-demo", "destination": "/index.html" },
    { "source": "/payment-success", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/integration", "destination": "/index.html" },
    { "source": "/indicators/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
